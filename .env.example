# Copy to .env and fill in. .env is git-ignored; never commit real values.
# All values are local. Memora needs no API keys, model provider or cloud account.

# PostgreSQL superuser for the container (used only by the init script that creates the app role).
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# The application's own database role. It is deliberately NOT a superuser so row-level security applies.
MEMORA_DB_NAME=memora
MEMORA_DB_USER=memora
MEMORA_DB_PASSWORD=change-me-app

# Signs login tokens (HS256). Use 32+ random characters, e.g. `openssl rand -base64 48`.
# If unset when running the jar directly, a random secret is generated and tokens stop working after a restart.
MEMORA_JWT_SECRET=

# Demo data: two tenants (Acme, Globex), four users and three agents per tenant.
MEMORA_SEED_DEMO_DATA=true
MEMORA_DEMO_PASSWORD=memora-demo

# FalkorDB (the memory graph). No password by default (local only). To set one, put it here AND add
# "--requirepass <password>" to MEMORA_FALKORDB_REDIS_ARGS (keep --appendonly yes).
MEMORA_FALKORDB_PASSWORD=
MEMORA_FALKORDB_REDIS_ARGS=--appendonly yes
# Context retrieval: graph (default, FalkorDB traversal) | hybrid | keyword (PostgreSQL only)
MEMORA_CONTEXT_RETRIEVAL=graph

# Host ports. If host port 3001 is taken (e.g. you run the dashboard on 3001), move the FalkorDB Browser.
MEMORA_FALKORDB_PORT=6379
MEMORA_FALKORDB_BROWSER_PORT=3001
MEMORA_DB_PORT=5432
MEMORA_API_PORT=8080
MEMORA_UI_PORT=3000
